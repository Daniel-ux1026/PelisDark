# Copy to .env. Never commit real values. Do not use quotes around values.
OPENAI_API_KEY=coloca_tu_clave_aqui
OPENAI_MODEL=gpt-4.1-mini
FRONTEND_URL=http://localhost:5173
# Optional for scripts/sync-catalog.mjs. TMDB API read access token.
TMDB_TOKEN=
# Production: valid TLS certificate and COOKIE_SECURE=true behind HTTPS.
# Local SQL Server development only: trustServerCertificate=true
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=PelisDark;encrypt=true;trustServerCertificate=true
DB_USER=pelisdark_app
DB_PASSWORD=
SQL_SA_PASSWORD=
COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
MAIL_FROM=no-reply@pelisdark.local
